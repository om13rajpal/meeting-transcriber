  "stroke": {
    "$description": "THE BORDER SCALE IS ONE VALUE. Emphasis is carried by the rule's colour, never its weight. See rule-tone. History, so this does not get undone: v1 shipped emph (2px) and stamp (2.5px) and the system read as a stack of thick bordered boxes; both were removed. A 1.5px middle tier was then tried and also removed, because Blink floors sub-pixel border widths, so border:1.5px computes and paints as 1px in Chrome at any devicePixelRatio while Safari and Firefox honour it. A tier that exists in only two of three engines is not a tier. If a box seems to need more weight than a hairline it does not need a heavier border, it needs a different background or more space.",
    "hair":   { "$value": "1px",    "$type": "dimension", "$description": "The entire border scale. Cards, panels, inputs, chips, badges, dividers, section rules, hero block edges, accent edges, the stamp outline. All of it." }
  },

  "rule-tone": {
    "$description": "The four colours that do the work the stroke scale deliberately does not. Change how loud a rule is by changing this, never its width.",
    "soft":       { "$value": "{color.neutral.rule-soft}",   "$type": "color", "$description": "List dividers, card and panel borders. Quietest, most used." },
    "strong":     { "$value": "{color.neutral.rule-strong}", "$type": "color", "$description": "Input borders, chip outlines, the time rail. A boundary you can act on." },
    "structural": { "$value": "{color.neutral.paper}",       "$type": "color", "$description": "Structural edges: hero block, stat triplet. Rationed." },
    "accent":     { "$value": "{color.accent.red}",          "$type": "color", "$description": "The accent edge. Section openers, the stamp outline, accent left-borders." }
  },

  "line-weight": {
    "$description": "Lines that are NOT borders, so they are not on the stroke scale. Do not use these to draw a box.",
    "focus-ring": { "$value": "2px",    "$type": "dimension", "$description": "Accessibility affordance, and the only line in the UI heavier than a hairline, which is exactly what a focus indicator should be. Never trade this down." },
