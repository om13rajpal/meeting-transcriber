DEEPGRAM_API_KEY=
# Optional. Lets the backend fetch each meeting's actual Deepgram-billed
# cost (Management API) instead of only showing an estimated cost. Find it
# in the Deepgram console. Leave blank to keep showing the estimate.
DEEPGRAM_PROJECT_ID=
# Optional. Per-minute rate (transcription + diarization) used for the
# estimated cost shown right when a meeting finishes, before the real
# billed amount is available. Defaults to 0.0071 if unset.
DEEPGRAM_RATE_PER_MINUTE_USD=
MONGODB_URI=mongodb://127.0.0.1:27017/meeting-transcriber
PORT=10000
ALLOWED_ORIGINS=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=transcriber@omrajpal.in
FRONTEND_URL=http://localhost:3000
