<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Without this key, macOS never shows the microphone permission prompt
	     at all and CoreAudio (which cpal uses to open the input device)
	     silently delivers empty/zeroed buffers instead of failing - no
	     error, no crash, just recorded silence on the mic track. This is
	     what caused system audio (gated by the separate Screen Recording
	     TCC permission) to record fine while the mic track came back empty. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Meeting Transcriber records your microphone so your side of a call is included in the transcript.</string>
	<!-- Same failure mode as NSMicrophoneUsageDescription above, for the
	     Core Audio process tap (capture/loopback_macos.rs) instead of the
	     microphone: without this key, TCC refuses kTCCServiceAudioCapture
	     outright ("Refusing authorization request for service
	     kTCCServiceAudioCapture ... without NSAudioCaptureUsageDescription
	     key" in the system log) - AudioHardwareCreateProcessTap still
	     reports success, the tap just never receives real audio, so system
	     audio came back silent while the mic track recorded fine. -->
	<key>NSAudioCaptureUsageDescription</key>
	<string>Meeting Transcriber records system audio so the other side of a call is included in the transcript.</string>
	<!-- This app is tray-only by design (see the "tray-only app" comment
	     near RecordingSlot in lib.rs) but was never actually configured to
	     be one - without this key, macOS gives it a normal Dock icon whose
	     click does nothing useful once its window is closed. Set here
	     (read by the OS before any of this app's own code runs, so there is
	     no Dock-icon flash at launch) and mirrored in lib.rs's
	     set_activation_policy(Accessory) call as a defensive backup. -->
	<key>LSUIElement</key>
	<true/>
</dict>
</plist>
